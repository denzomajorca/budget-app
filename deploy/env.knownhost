# Production .env for KnownHost shared hosting.
# Copy this to ~/budget-app/.env in cPanel File Manager and fill in the blanks.
# Never commit the filled-in copy.

APP_NAME=Budget
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://budget.dcadizstudio.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel > MySQL Databases: create a database and a user, give the user ALL PRIVILEGES.
# cPanel prefixes both names with your cPanel username, e.g. myuser_budget.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Files, not the database, so the app (and /setup) works before migrations run.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Password reset emails. cPanel > Email Accounts: create e.g. budget@dcadizstudio.com.
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Budget

# Long random string; unlocks https://budget.dcadizstudio.com/setup?token=...
# Clear it after setup if you like; set it again when a release needs database updates.
SETUP_TOKEN=
